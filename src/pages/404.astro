---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" noindex>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>Nothing here.</h1>
      <p class="lead">That page doesn't exist or has moved.</p>
      <a class="btn primary" href="/">Back to the homepage</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 110px 0 90px; }
  h1 { font-size: clamp(36px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.03em; margin: 14px 0 18px; font-weight: 700; }
  .lead { color: var(--muted); margin: 0 0 28px; }
  @media (max-width: 520px) { .hero { padding: 72px 0 60px; } }
</style>
