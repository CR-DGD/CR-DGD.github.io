---
import Base from "../layouts/Base.astro";
import Media from "../components/Media.astro";
import { getCollection } from "astro:content";
import { site } from "../site.config";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const L = site.links;
// A clip roughly 2:1 or wider gets the full-width banner layout when it's the featured project.
const isWide = (a?: string) => {
  if (!a) return false;
  const [w, h] = a.split("/").map(Number);
  return w / h >= 2;
};
const contact = [
  L.email && { label: "Email", href: `mailto:${L.email}` },
  L.github && { label: "GitHub", href: L.github },
  L.linkedin && { label: "LinkedIn", href: L.linkedin },
  L.steam && { label: "Steam", href: L.steam },
  L.itch && { label: "itch.io", href: L.itch },
].filter(Boolean) as { label: string; href: string }[];
---
<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{site.role} · {site.location}</p>
      <h1>Hi, I'm {site.name.split(" ")[0]}.<br /><span>{site.tagline}</span></h1>
      <p class="status"><i></i>{site.status}</p>
      <div class="cta">
        <a class="btn primary" href="#projects">See my work</a>
        {L.resume && <a class="btn" href={L.resume}>Résumé</a>}
        {contact.slice(0, 3).map((c) => <a class="btn" href={c.href}>{c.label}</a>)}
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="wrap">
      <p class="eyebrow">Selected work</p>
      <h2 class="section-title">Projects</h2>
      <div class="grid">
        {projects.map((p, i) => (
          <a class={`card ${i === 0 ? "feature" : ""} ${i === 0 && isWide(p.data.aspect) ? "banner" : ""}`} href={`/projects/${p.id}/`} style={`--accent:${p.data.accent}`}>
            <Media media={p.data.media} poster={p.data.poster} title={p.data.title} accent={p.data.accent} aspect={i === 0 ? p.data.aspect : undefined} />
            <div class="body">
              <p class="eyebrow">{p.data.role} · {p.data.period}</p>
              <h3>{p.data.title} <span class="arrow">→</span></h3>
              <p class="sum">{p.data.summary}</p>
              <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {(site.itchGames.length > 0 || L.itch) && (
  <section id="games">
    <div class="wrap">
      <p class="eyebrow">Playable</p>
      <div class="games-head">
        <h2 class="section-title">More games</h2>
        {L.itch && <a class="btn" href={L.itch}>All games on itch.io ↗</a>}
      </div>
      {site.itchGames.length > 0 && (
        <div class="games">
          {site.itchGames.map((g) => (
            <a class="game" href={g.url} target="_blank" rel="noopener">
              <div class={`thumb ${g.thumb ? "" : "empty"}`}>
                {g.thumb ? <img src={g.thumb} alt={`${g.title} cover`} loading="lazy" referrerpolicy="no-referrer" /> : <span>{g.title.slice(0, 1)}</span>}
              </div>
              <div class="gbody">
                <h3>{g.title} <span class="ext">↗</span></h3>
                <p>{g.blurb}</p>
                {g.tags && <ul class="tags">{g.tags.map((t) => <li>{t}</li>)}</ul>}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
  )}

  <section id="experience">
    <div class="wrap two">
      <div>
        <p class="eyebrow">Background</p>
        <h2 class="section-title">Experience</h2>
        <ol class="timeline">
          {site.experience.map((e) => (
            <li>
              <div class="when eyebrow">{e.when}</div>
              <div>
                <strong>{e.title}</strong> <span class="org">· {e.org}</span>
                <p>{e.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <p class="eyebrow">Toolbox</p>
        <h2 class="section-title">Skills</h2>
        <ul class="tags big">{site.skills.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <p class="eyebrow">Say hi</p>
      <h2 class="section-title">Let's talk.</h2>
      <p class="lead">I'm looking for entry-level roles in game development and software engineering, and I'm happy to relocate.</p>
      <div class="cta">
        {contact.map((c, i) => <a class={`btn ${i === 0 ? "primary" : ""}`} href={c.href}>{c.label}</a>)}
        {L.resume && <a class="btn" href={L.resume}>Résumé (PDF)</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 110px 0 90px; border-top: 0; }
  h1 { font-size: clamp(36px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.03em; margin: 14px 0 22px; font-weight: 700; }
  h1 span { display: block; font-size: clamp(19px, 2.4vw, 24px); line-height: 1.45; letter-spacing: -0.005em; color: var(--muted); font-weight: 400; margin-top: 18px; max-width: 40ch; }
  .status { display: inline-flex; align-items: center; gap: 10px; font-size: 15px; color: var(--muted); margin: 0 0 28px; }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: #3dd68c; box-shadow: 0 0 0 4px rgba(61,214,140,.15); flex: none; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .card {
    display: flex; flex-direction: column;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 14px; text-decoration: none;
    transition: border-color .2s, transform .2s;
  }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 60%, var(--line)); transform: translateY(-3px); }
  .card .body { padding: 16px 6px 6px; display: flex; flex-direction: column; gap: 8px; }
  .card h3 { margin: 0; font-size: 22px; letter-spacing: -0.01em; }
  .arrow { display: inline-block; color: var(--accent); transition: transform .2s; }
  .card:hover .arrow { transform: translateX(4px); }
  .sum { margin: 0 0 6px; color: var(--muted); }
  .feature { grid-column: 1 / -1; display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; align-items: center; }
  .feature h3 { font-size: 28px; }
  .feature.banner { grid-template-columns: 1fr; }
  .feature.banner .body { padding: 18px 8px 6px; }
  .feature.banner .sum { max-width: 62ch; }
  /* If the last card would sit alone in its row, stretch it full-width too. */
  @media (min-width: 821px) {
    .card:not(.feature):last-child:nth-child(even) { grid-column: 1 / -1; display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; align-items: center; }
  }

  .games-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 32px; }
  .games-head .section-title { margin-bottom: 0; }
  .games { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .game {
    display: flex; flex-direction: column; text-decoration: none;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; transition: border-color .2s, transform .2s;
  }
  .game:hover { border-color: var(--muted); transform: translateY(-3px); }
  .thumb { aspect-ratio: 315 / 250; background: var(--bg-2); display: grid; place-items: center; border-bottom: 1px solid var(--line); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb.empty { aspect-ratio: 5 / 1; }
  .thumb span { font-size: 28px; font-weight: 700; color: var(--muted); opacity: .5; }
  .gbody { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; }
  .gbody h3 { margin: 0; font-size: 17px; }
  .gbody p { margin: 0 0 4px; color: var(--muted); font-size: 15px; }
  .ext { color: var(--muted); font-size: 14px; }
  @media (max-width: 820px) { .games { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .games { grid-template-columns: 1fr; } }

  .two { display: grid; grid-template-columns: 1.5fr 1fr; gap: 56px; }
  .timeline { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 26px; }
  .timeline li { display: grid; grid-template-columns: 150px 1fr; gap: 16px; }
  .timeline .when { padding-top: 3px; }
  .timeline p { margin: 4px 0 0; color: var(--muted); font-size: 15.5px; }
  .org { color: var(--muted); }
  .tags.big li { font-size: 13px; padding: 5px 10px; color: var(--text); }
  .lead { color: var(--muted); max-width: 52ch; margin: -12px 0 26px; }

  @media (max-width: 820px) {
    .grid, .two { grid-template-columns: 1fr; }
    .feature { grid-template-columns: 1fr; }
    .games-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 32px; }
  .games-head .section-title { margin-bottom: 0; }
  .games { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .game {
    display: flex; flex-direction: column; text-decoration: none;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; transition: border-color .2s, transform .2s;
  }
  .game:hover { border-color: var(--muted); transform: translateY(-3px); }
  .thumb { aspect-ratio: 315 / 250; background: var(--bg-2); display: grid; place-items: center; border-bottom: 1px solid var(--line); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb.empty { aspect-ratio: 5 / 1; }
  .thumb span { font-size: 28px; font-weight: 700; color: var(--muted); opacity: .5; }
  .gbody { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; }
  .gbody h3 { margin: 0; font-size: 17px; }
  .gbody p { margin: 0 0 4px; color: var(--muted); font-size: 15px; }
  .ext { color: var(--muted); font-size: 14px; }
  @media (max-width: 820px) { .games { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .games { grid-template-columns: 1fr; } }

  .two { gap: 16px; }
  }
  @media (max-width: 520px) {
    .hero { padding: 72px 0 60px; }
    .timeline li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
